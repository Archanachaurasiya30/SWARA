# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name. gemini-2.5-flash is being retired on 1 Dec 2026, so use a newer one.
# Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.5-flash-lite

# Port for this AI server (your React app runs on 5173)
PORT=5001

# Websites allowed to call this server (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
